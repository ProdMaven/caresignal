{
  "name": "caresignal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "export DATABASE_URL=\"${DATABASE_URL:-file:./dev.db}\"; prisma db push --skip-generate --accept-data-loss && tsx scripts/seed.ts && next start -H 0.0.0.0 -p ${PORT:-3000}",
    "seed": "export DATABASE_URL=\"${DATABASE_URL:-file:./dev.db}\"; prisma db push --skip-generate --accept-data-loss && tsx scripts/seed.ts",
    "lint": "eslint",
    "eval": "tsx eval/run.ts",
    "safety": "tsx eval/run.ts --set redteam",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@huggingface/transformers": "^4.3.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.6"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
