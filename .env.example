ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
DATABASE_URL="file:./dev.db"
USE_MOCKS=true

# Added by the scaffold
# USE_MOCKS: unset or anything other than "false" serves mocks from src/mocks/.
# DATABASE_URL: falls back to file:./dev.db (relative to prisma/) when unset.
# PORT: `npm start` binds 0.0.0.0 on $PORT (default 3000). Railway sets it.
PORT=3000
# INVITE_CODES: comma separated invite codes for invitation-only entry. Unset uses the demo judge code in README.
INVITE_CODES=
# USE_REAL_DATA: leave unset. Data routes use the in-memory demo store until the Prisma versions land.
